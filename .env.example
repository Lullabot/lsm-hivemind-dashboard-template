# Copy to .env and fill in if you wire up the optional integrations.
# The dashboard server itself does not read these — only your fetch scripts do.

# GitHub (for PR staleness fetcher, if you write one)
# GH_TOKEN=

# Noko (for the time-entry fetcher, if you write one)
# NOKO_TOKEN=

# Override default data paths if your memory bank lives elsewhere.
# HIVEMIND_MEMORY_BANK=/absolute/path/to/memory-bank
# HIVEMIND_AGENTS_DIR=/absolute/path/to/agents
